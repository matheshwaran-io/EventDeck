# Copy this file to .env.local (never commit .env.local) and fill in the values.
# Full reference: docs/ENVIRONMENT_VARIABLES.md · Windows guide: docs/WINDOWS_SETUP_AND_RUN.md
# NEXT_PUBLIC_* values are sent to the browser — never put a secret in one.

# ─── App ────────────────────────────────────────────────────────────────
# Base URL used in auth e-mail links. Local: http://localhost:3000 · Production: https://eventdeck.online
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_UNIVERSITY_NAME="SRM University, KTR Campus"

# ─── Hosted Supabase ───────────────────────────────────────────────────
# From Supabase Dashboard → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
# Publishable key (sb_publishable_…) or legacy anon key (NEXT_PUBLIC_SUPABASE_ANON_KEY).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# Secret key (sb_secret_…) or legacy service_role key (SUPABASE_SERVICE_ROLE_KEY). Server only!
SUPABASE_SECRET_KEY=sb_secret_your-key

# ─── Hosted Supabase PostgreSQL ─────────────────────────────────────────
# From Supabase Dashboard → Connect → Transaction pooler (port 6543)
# Used by Next.js application runtime (server actions, queries, mutations)
DATABASE_URL=postgresql://postgres.<your-project-ref>:<your-db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# From Supabase Dashboard → Connect → Session pooler (port 5432). Used by Drizzle Kit
# for migrations. (The "Direct connection" host db.<ref>.supabase.co is IPv6-only unless
# the paid IPv4 add-on is enabled, so the session pooler works on more networks.)
DIRECT_URL=postgresql://postgres.<your-project-ref>:<your-db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ─── Razorpay (TEST MODE ONLY) ──────────────────────────────────────────
# Keys must start with rzp_test_ — live keys are refused by the app.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-test-key-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret
# Local payment simulator when Razorpay keys are blank. Ignored on Vercel production.
ALLOW_MOCK_PAYMENTS=false

# ─── Ops ────────────────────────────────────────────────────────────────
# Shared secret for /api/cron/expire-holds (Vercel Cron sends it as a Bearer token).
CRON_SECRET=generate-a-long-random-string

# ─── Local tooling (never set these in Vercel) ──────────────────────────
# Password for demo accounts created by `npm run db:seed`.
SEED_DEMO_PASSWORD=choose-a-demo-password
# Used by `npm run admin:create`.
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=
# Optional, used by `npm run seed:dsa` (the script appends the generated password itself).
# DSA_ORGANIZER_EMAIL=dsa.events@eventdeck.test

# Set automatically by Vercel — do not add locally: VERCEL_ENV, VERCEL_URL, NEXT_PUBLIC_VERCEL_ENV.
