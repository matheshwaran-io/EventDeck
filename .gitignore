# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*_backup.sql
*.sql.bak

# debug / local logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
!.env.example

# playwright
/test-results/
/playwright-report/
/e2e/.auth/

# e2e dev server build dir (and any other NEXT_DIST_DIR build dirs)
/.next-e2e/
/.next-*/
/e2e/.fake-camera/
!.env.test.example
