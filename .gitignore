# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
*.pem
*.key

# local database dumps / backups (may contain personal data, never commit)
*_backup.sql
*.sql.bak
*.dump
/scripts/backups/

# editor / office temp files
*.swp
*~
~$*
.idea/

# report generator intermediates (rebuild with docs/reports/final-report/working-notes/build_report.py)
*.generated.docx

# debug / local logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files: real values stay local; only the templates are committed
.env*
!.env.example
!.env.test.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright
/test-results/
/playwright-report/
/e2e/.auth/

# e2e dev server build dir (and any other NEXT_DIST_DIR build dirs)
/.next-e2e/
/.next-*/
/e2e/.fake-camera/
