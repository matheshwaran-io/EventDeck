# Dedicated Supabase TEST project for automated integration + E2E tests.
# Create a second (free) Supabase project, run `npm run test:db:migrate`, then
# `npm run test:db:seed`. Never point this at your primary/production project.
#
# In the test project's dashboard: Authentication → Sign In / Providers → Email →
# turn OFF "Confirm email" (UI signup tests sign in immediately; no mail is sent).

NEXT_PUBLIC_APP_URL=http://localhost:3100
NEXT_PUBLIC_SUPABASE_URL=https://your-test-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-test-key
SUPABASE_SECRET_KEY=sb_secret_your-test-key

# Session pooler (port 5432) — used by tests, migrations and the seed.
DATABASE_URL=postgresql://postgres.your-test-project-ref:your-test-db-password@aws-0-region.pooler.supabase.com:5432/postgres
DIRECT_URL=postgresql://postgres.your-test-project-ref:your-test-db-password@aws-0-region.pooler.supabase.com:5432/postgres

# Payments in tests always use the built-in simulator — leave Razorpay keys empty here.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
ALLOW_MOCK_PAYMENTS=true
CRON_SECRET=any-random-test-string

# Password for demo accounts created by `npm run test:db:seed` (used by E2E sign-ins).
SEED_DEMO_PASSWORD=choose-a-test-password

# Only if you have no separate test project and accept isolated, self-cleaning
# test fixtures being written to the primary project:
# ALLOW_TESTS_ON_PRIMARY_PROJECT=true
